{
  // Cloudflare Workers config for the LASORDA News Ticker.
  // Setup on a new Cloudflare account: see "Hosting" in CLAUDE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lasorda-news-ticker",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lasorda-ticker-db",
      // Replace with the id printed by `npx wrangler d1 create lasorda-ticker-db`.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
