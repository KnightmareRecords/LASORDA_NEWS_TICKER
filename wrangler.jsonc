{
	// Cloudflare Workers config for the LASORDA News Ticker.
	// Setup on a new Cloudflare account: see "Hosting" in CLAUDE.md.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lasorda-news-ticker",
	"main": "vinext/server/fetch-handler",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Workers AI: rewrites feed stories into short ticker lines (lib/ai-summary.ts). Free plan: 10,000 neurons/day.
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lasorda-ticker-db",
			// Jay's Cloudflare D1 database (created by scripts/setup-cloudflare.mjs).
			"database_id": "e7bc5cc0-4b7f-4a50-b651-1e9171e6ed8a",
			"migrations_dir": "drizzle"
		}
	],
	// Uploaded promo images/videos. Free tier 10 GB. Needs R2 turned on in the Cloudflare dashboard once.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "lasorda-ticker-media"
		}
	]
}
